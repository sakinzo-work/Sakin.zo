# Default: the same Render backend used by the original website.
# Local Vite dev/preview forwards /api and /uploads here.
BACKEND_ORIGIN=https://sakinzo.onrender.com
# Leave blank for automatic local proxy / hosted Render API selection.
# To use the optional local backend: BACKEND_ORIGIN=http://localhost:5000
# To use another API in production: VITE_API_BASE=https://your-api.example/api
VITE_API_BASE=
# Optional base path when deploying below a domain subdirectory.
VITE_BASE_PATH=/

# Public deployment URL used when generating sitemap.xml and robots.txt.
VITE_SITE_URL=https://sakinzo-work.github.io/Sakin.zo/
